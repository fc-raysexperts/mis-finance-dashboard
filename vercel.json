{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/npdCronRefreshPark.js": {
      "maxDuration": 300
    },
    "api/npdParkTransactions.js": {
      "maxDuration": 300
    },
    "api/npdAllParksSummary.js": {
      "maxDuration": 300
    },
    "api/npdClearCache.js": {
      "maxDuration": 60
    },
    "api/npdGenericAccountsRefresh.js": {
      "maxDuration": 300
    },
    "api/obInvoiced.js": {
      "maxDuration": 300
    }
  }
}
