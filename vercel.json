{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/npdCronRefreshPark.js": { "maxDuration": 300 },
    "api/npdParkTransactions.js": { "maxDuration": 300 },
    "api/npdAllParksSummary.js": { "maxDuration": 300 },
    "api/npdClearCache.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/npdCronRefreshPark?park=Jaisalmer",    "schedule": "30 0 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Kolayat",      "schedule": "35 0 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Dechu",        "schedule": "40 0 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Lunkaransar",  "schedule": "45 0 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Napasar",      "schedule": "50 0 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Panchu",       "schedule": "55 0 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Pugal",        "schedule": "0 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Bhamatsar",    "schedule": "5 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Sanchore",     "schedule": "10 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Tosham",       "schedule": "15 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=SS%20Nagar",   "schedule": "20 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Thukariyasar", "schedule": "25 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Baithwasiya",  "schedule": "30 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Jasarasar",    "schedule": "35 1 * * *" },
    { "path": "/api/npdCronRefreshPark?park=Sheruna",      "schedule": "40 1 * * *" }
  ]
}
